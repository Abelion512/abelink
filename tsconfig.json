{
  // tsconfig.json — gate payung `bun run typecheck` (dan yang dibaca editor).
  //
  // Isi = ZONA BERSIH hasil pengukuran 2026-09-26: seluruh subtree yang sudah
  // menghasilkan 0 error tsc. `allowJs: true` + `checkJs: false` (lihat
  // tsconfig.base.json) membuat file .js/.jsx lama tetap boleh ada tanpa
  // dicek, jadi gate ini TIDAK menghalangi strangler.
  //
  // M2a (2026-09-26): `cli/**` + `bin/**/*.tsx` SUDAH masuk. Diukur 114 error
  // sebelum pengetikan; sekarang 0, jadi gate ini berlaku penuh untuk TUI.
  //
  // Sub-gate: tsconfig.node.json (sidecar/scripts/evaluation/tests) lewat
  // `bun run typecheck:node`. Sub-gate renderer BELUM dibuat: src/** belum
  // punya berkas .ts, dan tsc menolak config tanpa input (TS18003) — dibuat saat
  // berkas .ts pertama mendarat di M2/M6.
  "extends": "./tsconfig.base.json",
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "sidecar/**/*.ts",
    "scripts/**/*.ts",
    "evaluation/**/*.ts",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "cli/**/*.ts",
    "cli/**/*.tsx",
    "bin/**/*.ts",
    "bin/**/*.tsx"
  ]
}
