{
  // tsconfig.renderer.json — sub-gate RENDERER (W2-1, js-to-ts-spec.md §5).
  //
  // Dibuat di sini (bukan M2) karena B-20: config tanpa input .ts = error
  // TS18003; tauri-bridge.ts adalah berkas .ts PERTAMA di src/**.
  //
  // Guardrail boundary Tauri: types DISEMPITKAN ke [] (tanpa tipe Node) —
  // `fs`/`path`/`process` di src/** langsung jadi error. lib DOM dipertahankan
  // (webview renderer). Masuk rantai `bun run typecheck` sejak PR ini.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": []
  },
  // sidecar/types/*.d.ts: deklarasi ambient lintas-zona (bun:sqlite, deps
  // tanpa tipe) — headlessCli.ts di src/api/ai memakainya dan di-load program
  // node-zone via import test, jadi program renderer juga wajib melihatnya.
  "include": ["src/**/*.ts", "src/**/*.tsx", "sidecar/types/**/*.d.ts"]
}
