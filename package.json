{
  "name": "abelink",
  "version": "1.6.0-alpha.10",
  "description": "Abelink (ABELINK - Metacognitive Artificial Relational Knowledge): Privacy-first Autonomous AI OS Companion for Linux",
  "author": "Abelion512",
  "homepage": "https://github.com/Abelion512/abelink/",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "test:live": "vitest run --config vitest.live.config.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json",
    "typecheck:extension": "tsc --noEmit -p tsconfig.extension.json",
    "typecheck:renderer": "tsc --noEmit -p tsconfig.renderer.json",
    "cron": "bun bin/abelink-cron.ts",
    "cron:daemon": "bun bin/abelink-cron.ts daemon",
    "test:known-issues": "vitest run tests/trading.*.test.ts",
    "test:harness": "bun tests/harness/stress-watermark.harness.ts && bun tests/harness/stress-watermark-v2.harness.ts",
    "perf": "bun evaluation/perf-gate.ts",
    "perf:save": "bun evaluation/perf-gate.ts --save",
    "bench:quick": "bun evaluation/bench-gate.ts",
    "bench:save": "bun evaluation/bench-gate.ts --save",
    "bench:local": "bun evaluation/bench/run-local.ts",
    "bench:local-stub": "bun evaluation/bench/run-local.ts --stub",
    "verify": "bash scripts/verify.sh",
    "sync-version": "bun scripts/sync-version.ts",
    "brand:icons": "bash scripts/apply-brand-assets.sh",
    "harness": "bun sidecar/engine.ts",
    "harness:export": "bun scripts/harness-export.ts",
    "harness:diagnose": "bun scripts/harness-diagnose.ts",
    "live:tui": "bun scripts/live-tui-smoke.ts",
    "build:sidecar": "bun build sidecar/engine.ts --compile --minify --outfile=dist-sidecar/abelink-engine && chmod +x dist-sidecar/abelink-engine",
    "build:extension": "bun scripts/build-extension.ts",
    "build:deb": "bun run build:sidecar && tauri build --bundles deb",
    "build:dist": "bun run build:sidecar && tauri build",
    "app": "bash scripts/dev.sh",
    "app:raw": "tauri dev",
    "benchmark:echo": "bun evaluation/terminal-bench.ts",
    "benchmark:run": "bun evaluation/run.ts",
    "benchmark:deepeval": "bun evaluation/deepeval-runner.ts",
    "benchmark:adapter": "bun evaluation/abelink-adapter.ts",
    "cli:agent": "bun bin/abelink.ts agent run"
  },
  "bin": {
    "abelink": "bin/abelink.ts"
  },
  "type": "module",
  "overrides": {
    "dompurify": "^3.4.12",
    "tar": "^7.5.7",
    "adm-zip": "^0.6.0"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "@opentui/core": "^0.5.12",
    "@opentui/keymap": "^0.5.12",
    "@opentui/solid": "^0.5.12",
    "@orama/orama": "^3.1.18",
    "@tauri-apps/api": "^2",
    "dexie": "^4.3.0",
    "dexie-export-import": "^4.1.4",
    "duck-duck-scrape": "^2.2.7",
    "googleapis": "^174.0.1",
    "htmlparser2": "10.1.0",
    "jsonrepair": "^3.14.0",
    "lucide-react": "^1.25.0",
    "mammoth": "^1.12.0",
    "msedge-tts": "^2.0.4",
    "openai": "^6.17.0",
    "pdf-parse": "^2.4.5",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.13.0",
    "rehype-external-links": "^3.0.0",
    "remark-gfm": "^4.0.1",
    "solid-js": "^1.9.15",
    "telegraf": "^4.16.3",
    "youtube-transcript-plus": "^1.1.2",
    "yt-search": "^2.13.1",
    "ytmusic-api": "5.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.1.1",
    "daisyui": "^5.5.14",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "fake-indexeddb": "^6.2.5",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^7.2.6",
    "vitest": "^4.1.10"
  }
}
