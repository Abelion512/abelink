{
  "name": "abelink",
  "version": "1.2.0-alpha.6",
  "description": "Abelink (ABELINK - Metacognitive Artificial Relational Knowledge): Privacy-first Autonomous AI OS Companion for Linux",
  "author": "Abelion512",
  "homepage": "https://github.com/Abelion512/abelink/",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "test:harness": "node tests/harness/stress-watermark.harness.mjs && node tests/harness/stress-watermark-v2.harness.mjs",
    "perf": "bun evaluation/perf-gate.mjs",
    "perf:save": "bun evaluation/perf-gate.mjs --save",
    "bench:quick": "bun evaluation/bench-gate.mjs",
    "bench:save": "bun evaluation/bench-gate.mjs --save",
    "bench:local": "bun evaluation/bench/run-local.mjs",
    "bench:local-stub": "bun evaluation/bench/run-local.mjs --stub",
    "verify": "bash scripts/verify.sh",
    "sync-version": "node scripts/sync-version.mjs",
    "harness": "bun sidecar/engine.mjs",
    "harness:export": "node scripts/harness-export.mjs",
    "harness:diagnose": "node scripts/harness-diagnose.mjs",
    "build:sidecar": "bun build sidecar/engine.mjs --compile --minify --outfile=dist-sidecar/abelink-engine && chmod +x dist-sidecar/abelink-engine",
    "build:deb": "bun run build:sidecar && tauri build --bundles deb",
    "build:dist": "bun run build:sidecar && tauri build",
    "app": "bash scripts/dev.sh",
    "app:raw": "tauri dev",
    "benchmark:echo": "node evaluation/terminal-bench.mjs",
    "benchmark:run": "node evaluation/run.mjs",
    "benchmark:deepeval": "node evaluation/deepeval-runner.mjs",
    "benchmark:adapter": "node evaluation/abelink-adapter.mjs"
  },
  "type": "module",
  "overrides": {
    "dompurify": "^3.4.12",
    "tar": "^7.5.7",
    "adm-zip": "^0.6.0"
  },
  "dependencies": {
    "@fontsource/poppins": "^5.2.7",
    "@huggingface/transformers": "^4.2.0",
    "@monaco-editor/react": "^4.7.0",
    "@orama/orama": "^3.1.18",
    "@tauri-apps/api": "^2",
    "axios": "^1.13.4",
    "dexie": "^4.3.0",
    "dexie-export-import": "^4.1.4",
    "duck-duck-scrape": "^2.2.7",
    "googleapis": "^174.0.1",
    "htmlparser2": "10.1.0",
    "jsonrepair": "^3.14.0",
    "lucide-react": "^1.25.0",
    "mammoth": "^1.12.0",
    "msedge-tts": "^2.0.4",
    "openai": "^6.17.0",
    "pdf-parse": "^2.4.5",
    "react-force-graph-2d": "^1.29.1",
    "react-icons": "^5.6.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.13.0",
    "react-syntax-highlighter": "^16.1.0",
    "rehype-external-links": "^3.0.0",
    "remark-gfm": "^4.0.1",
    "telegraf": "^4.16.3",
    "three": "^0.185.1",
    "youtube-transcript-plus": "^1.1.2",
    "yt-search": "^2.13.1",
    "ytmusic-api": "5.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@tauri-apps/cli": "^2",
    "@vitejs/plugin-react": "^5.1.1",
    "daisyui": "^5.5.14",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "fake-indexeddb": "^6.2.5",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tailwindcss": "^4.1.18",
    "vite": "^7.2.6",
    "vitest": "^4.1.10"
  }
}
