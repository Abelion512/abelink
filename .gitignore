# ─────────────────────────────────────────────────────────────────
# Dependencies
# ─────────────────────────────────────────────────────────────────
/node_modules/
/bun.lock.bak

# Sidecar: node_modules lokal tidak boleh ikut ter-commit, KECUALI stub
# 'electron' yang memang disengaja (menangkap import modul era Electron
# lama di runtime node sidecar). /node_modules/ root saja tidak cukup.
/sidecar/node_modules/*
!/sidecar/node_modules/electron/

# ─────────────────────────────────────────────────────────────────
# Build output
# ─────────────────────────────────────────────────────────────────
/dist/
/out/
/build/
/dist-sidecar/
/graphify-out/

# ─────────────────────────────────────────────────────────────────
# Rust
# ─────────────────────────────────────────────────────────────────
**/*.rs.bk

# ─────────────────────────────────────────────────────────────────
# Environment & secrets
# ─────────────────────────────────────────────────────────────────
.env
.env.*
*.pem
*.key
.env.local
.env.development.local
.env.test.local
.env.production.local

# ─────────────────────────────────────────────────────────────────
# Logs & cache
# ─────────────────────────────────────────────────────────────────
*.log*
.eslintcache
.cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─────────────────────────────────────────────────────────────────
# Test coverage
# ─────────────────────────────────────────────────────────────────
/coverage/

# ─────────────────────────────────────────────────────────────────
# Editor / OS noise
# ─────────────────────────────────────────────────────────────────
.vscode/
.idea/
.DS_Store
*.swp

# ─────────────────────────────────────────────────────────────────
# Local worktrees & agent scratch
# (per-tool plans/states — never part of the repo)
# ─────────────────────────────────────────────────────────────────
/.worktrees/
/worktrees/
/.claude/
/.hermes/
/.zcode/
/.impeccable/
/.remember/
/.superpowers/
/.plans/
__pycache__/

# ─────────────────────────────────────────────────────────────────
# Project-specific runtime artefacts
# ─────────────────────────────────────────────────────────────────
workflow
mark_chrome_profile
web.whatsapp.com.html
/web.whatsapp.com_files
PLUGIN_SYSTEM_SRS.md
.mark/
social-data-engine/
/scripts/tmp-*
docs/ss_report

# Generated by sync tooling — regenerated on demand, never commit
/upstream-diff-report.json

# Local lint baseline used by agent verification runs
/.lint-baseline/

# Generated HTML trackers (open in browser, never commit)
/project-tracker.html
/mark-agent-tracker.html

# Agent-CLI local configs (Codex, Antigravity, etc.)
/.codex/
/.agents/

# Browser use feature artifacts
# Chrome profile used by browser-use (never commit - local only)
.mark_chrome_profile/

# Browser-use session state (per-session tab groups)
.browser-use-state/

# Extension temporary directories generated at runtime
extension/tmp-*

# History of browser-use group assignments
.history/

# ─────────────────────────────────────────────────────────────────
# Heavy media & binary assets (private repo policy: avoid bloated git history)
# ─────────────────────────────────────────────────────────────────
*.mp4
*.mov
*.avi
*.mkv
*.webm
*.flv
*.wmv
*.iso
*.tar.gz
*.tgz
*.zip
*.7z
*.rar

# Model weights and raw binary dumps
*.safetensors
*.gguf
*.onnx
*.bin

# Allow tracked assets
!assets/**
!src/assets/**
!resources/**

# ─────────────────────────────────────────────────────────────────
# Local agent scratch & temporary state
# ─────────────────────────────────────────────────────────────────
/tasks/
/tests/stability/

