# Generated by sync tooling — regenerated on demand, never commit
/upstream-diff-report.json

# Local lint baseline used by agent verification runs
/.lint-baseline/

# Generated HTML trackers (open in browser, never commit)
/project-tracker.html
/mark-agent-tracker.html

# Agent-CLI local configs (Codex, Antigravity, etc.)
/.codex/

# Browser use feature artifacts
# Chrome profile used by browser-use (never commit - local only)
.mark_chrome_profile/

# Browser-use session state (per-session tab groups)
.browser-use-state/

# Extension temporary directories generated at runtime
extension/tmp-*

# History of browser-use group assignments
.history/

# ─────────────────────────────────────────────────────────────────
# Heavy media & binary assets (private repo policy: avoid bloated git history)
# ─────────────────────────────────────────────────────────────────
*.mp4
*.mov
*.avi
*.mkv
*.webm
*.flv
*.wmv
*.iso
*.tar.gz
*.tgz
*.zip
*.7z
*.rar

# Model weights and raw binary dumps
*.safetensors
*.gguf
*.onnx
*.bin

# Allow tracked assets
!assets/**
!src/assets/**
!resources/**

